# Supabase (server-only database access)
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Preferred server secret. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Optional legacy fallback if the project still uses the older service-role key name.
SUPABASE_SERVICE_ROLE_KEY=

# Token encryption (32-char random string)
TOKEN_ENCRYPTION_KEY=

# Operator authentication
AUTH_SECRET=
APP_PASSWORD=

# Cron authentication
CRON_SECRET=

# Facebook / Instagram
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=https://social.socialtizemg.com/api/oauth/facebook/callback
# Optional override; current implementation defaults to v26.0.
META_GRAPH_VERSION=v26.0

# Arcade.dev (Twitter/X, Reddit)
ARCADE_API_KEY=
ARCADE_BASE_URL=https://api.arcade.dev/v1

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://social.socialtizemg.com/api/oauth/linkedin/callback

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://social.socialtizemg.com/api/oauth/tiktok/callback

# YouTube / Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://social.socialtizemg.com/api/oauth/google/callback

# AI
ANTHROPIC_API_KEY=

# App
NEXT_PUBLIC_APP_URL=https://social.socialtizemg.com
NEXT_PUBLIC_BASE_URL=https://social.socialtizemg.com
